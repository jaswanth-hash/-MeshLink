<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mesh_error_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/mesh_error" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mesh_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/mesh_error_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
