<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mesh_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/adminHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:text="👑 MeshLink Admin"
                    android:textColor="@color/mesh_text_primary"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/adminFingerprintSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Admin Fingerprint: Uninitialized"
                    android:textColor="@color/mesh_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/adminCloseButton"
                android:layout_width="72dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_secondary_button"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:text="Done"
                android:textAllCaps="false"
                android:textColor="@color/mesh_blue"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Unauthenticated Container -->
        <LinearLayout
            android:id="@+id/adminUnauthContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="🔒 Local Admin Identity Required"
                android:textColor="@color/mesh_text_primary"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="This device does not currently hold a hardware-backed Admin identity in Android KeyStore. Initialize Admin identity to bootstrap security trust."
                android:textColor="@color/mesh_text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/initAdminButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_primary_button"
                android:fontFamily="sans-serif-medium"
                android:text="Initialize Admin Identity"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Authenticated Admin Content Container -->
        <LinearLayout
            android:id="@+id/adminContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Network Overview Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="Network Overview"
                android:textColor="@color/mesh_text_primary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Connected Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Connected"
                        android:textColor="@color/mesh_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/statConnectedCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="0"
                        android:textColor="@color/mesh_text_primary"
                        android:textSize="22sp" />
                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <!-- Known Nodes Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Known Nodes"
                        android:textColor="@color/mesh_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/statKnownCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="0"
                        android:textColor="@color/mesh_text_primary"
                        android:textSize="22sp" />
                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <!-- Active Routes Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Routes"
                        android:textColor="@color/mesh_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/statRoutesCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="0"
                        android:textColor="@color/mesh_text_primary"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Topology Snapshot Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="Mesh Topology"
                android:textColor="@color/mesh_text_primary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/topologySummaryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Topology: Local Node Active"
                    android:textColor="@color/mesh_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/topologyDetailsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="No remote routes currently active."
                    android:textColor="@color/mesh_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Emergency Broadcast Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="Emergency Broadcast"
                android:textColor="@color/mesh_text_primary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/broadcastInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:hint="Enter emergency broadcast message..."
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:padding="12dp"
                    android:textColor="@color/mesh_text_primary"
                    android:textColorHint="@color/mesh_text_muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/sendBroadcastButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_primary_button"
                    android:fontFamily="sans-serif-medium"
                    android:text="Send Signed Broadcast"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/broadcastStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Ready for broadcast."
                    android:textColor="@color/mesh_text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Node Management Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="Node Management &amp; Revocation"
                android:textColor="@color/mesh_text_primary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/nodeTargetInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="Node ID to block/unblock"
                        android:inputType="text"
                        android:padding="10dp"
                        android:textColor="@color/mesh_text_primary"
                        android:textColorHint="@color/mesh_text_muted"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/blockNodeButton"
                        android:layout_width="80dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_danger_outline_button"
                        android:fontFamily="sans-serif-medium"
                        android:minHeight="0dp"
                        android:text="Block"
                        android:textAllCaps="false"
                        android:textColor="@color/mesh_error"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/unblockNodeButton"
                        android:layout_width="80dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_secondary_button"
                        android:fontFamily="sans-serif-medium"
                        android:minHeight="0dp"
                        android:text="Unblock"
                        android:textAllCaps="false"
                        android:textColor="@color/mesh_blue"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nodeManagementStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="No node management actions performed."
                    android:textColor="@color/mesh_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
