<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mesh_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <!-- Screen Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:text="@string/sim_title"
            android:textColor="@color/mesh_text_primary"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sim_disclaimer"
            android:textColor="@color/mesh_text_secondary"
            android:textSize="13sp" />

        <!-- Graph Canvas Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <com.meshlink.simulation.SimulationGraphView
                android:id="@+id/simGraph"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@color/mesh_surface_muted" />
        </LinearLayout>

        <!-- Delivery Status & Route Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/simDeliveryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/sim_status_idle"
                android:textColor="@color/mesh_blue"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/simRouteText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/sim_route_idle"
                android:textColor="@color/mesh_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/simHopText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sim_hops_idle"
                android:textColor="@color/mesh_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Live Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/sim_live_status"
                android:textColor="@color/mesh_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/simLiveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/mesh_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Topology Controls Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sim_topology"
            android:textColor="@color/mesh_text_primary"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Presets Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/simLoadDefault"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary_button"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="0dp"
                    android:text="@string/sim_load_default"
                    android:textAllCaps="false"
                    android:textColor="@color/mesh_blue"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/simReset"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary_button"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="0dp"
                    android:text="@string/sim_reset"
                    android:textAllCaps="false"
                    android:textColor="@color/mesh_blue"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/simFail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_danger_outline_button"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:text="@string/sim_fail"
                android:textAllCaps="false"
                android:textColor="@color/mesh_error"
                android:textSize="13sp" />

            <!-- Add / Remove Node -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/simNodeInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="@string/sim_node_hint"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/mesh_text_primary"
                    android:textColorHint="@color/mesh_text_muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/simAddNode"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="0dp"
                    android:text="@string/sim_add_node"
                    android:textAllCaps="false"
                    android:textColor="@color/mesh_blue"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/simRemoveNode"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_danger_outline_button"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="0dp"
                    android:text="@string/sim_remove"
                    android:textAllCaps="false"
                    android:textColor="@color/mesh_error"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Connect / Disconnect Link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/simLinkA"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="A"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/mesh_text_primary"
                    android:textColorHint="@color/mesh_text_muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/simLinkB"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="B"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/mesh_text_primary"
                    android:textColorHint="@color/mesh_text_muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/simConnect"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="0dp"
                    android:text="@string/sim_connect"
                    android:textAllCaps="false"
                    android:textColor="@color/mesh_blue"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/simDisconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_danger_outline_button"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="0dp"
                    android:text="@string/sim_disconnect"
                    android:textAllCaps="false"
                    android:textColor="@color/mesh_error"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Disable / Enable Node -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/simDisableNode"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="@string/sim_disable_hint"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/mesh_text_primary"
                    android:textColorHint="@color/mesh_text_muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/simDisable"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_danger_outline_button"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="0dp"
                    android:text="@string/sim_disable"
                    android:textAllCaps="false"
                    android:textColor="@color/mesh_error"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/simEnable"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="0dp"
                    android:text="@string/sim_enable"
                    android:textAllCaps="false"
                    android:textColor="@color/mesh_blue"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Send Simulation Packet Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sim_send_section"
            android:textColor="@color/mesh_text_primary"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/simFrom"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="@string/sim_from"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="A"
                    android:textColor="@color/mesh_text_primary"
                    android:textColorHint="@color/mesh_text_muted"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <EditText
                    android:id="@+id/simTo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="@string/sim_to"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="D"
                    android:textColor="@color/mesh_text_primary"
                    android:textColorHint="@color/mesh_text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/simMessageBody"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="@string/sim_message_hint"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="hello mesh"
                android:textColor="@color/mesh_text_primary"
                android:textColorHint="@color/mesh_text_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/simSend"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_primary_button"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:text="@string/sim_send"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Event Log Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sim_event_log"
            android:textColor="@color/mesh_text_primary"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/simLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:minHeight="120dp"
                android:textColor="@color/mesh_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
